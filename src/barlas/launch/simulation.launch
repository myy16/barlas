<?xml version="1.0"?>
<!-- BARLAS Comprehensive Simulation Launch -->
<!-- Teknofest İnsansız Kara Aracı Yarışması - Tam Simülasyon Ortamı -->

<launch>
    <!-- ========== MAVROS Connection (ArduPilot SITL) ========== -->
    <include file="$(find mavros)/launch/apm.launch">
        <arg name="fcu_url" value="udp://:14550@127.0.0.1:14551"/>
        <arg name="gcs_url" value=""/>
        <arg name="target_system_id" value="1"/>
        <arg name="target_component_id" value="1"/>
        <arg name="log_output" value="screen"/>
    </include>

    <!-- ========== Gazebo Simulation World ========== -->
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name" value="$(find barlas)/worlds/barlas.world"/>
        <arg name="paused" value="false"/>
        <arg name="use_sim_time" value="true"/>
        <arg name="gui" value="true"/>
        <arg name="headless" value="false"/>
        <arg name="debug" value="false"/>
        <arg name="verbose" value="true"/>
    </include>

    <!-- ========== BARLAS Robot Model ========== -->
    <param name="robot_description" command="$(find xacro)/xacro $(find barlas)/models/barlas_simple.urdf"/>

    <!-- Robot state publisher -->
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher">
        <param name="publish_frequency" type="double" value="50.0"/>
    </node>

    <!-- Joint state publisher -->
    <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher">
        <param name="use_gui" value="false"/>
    </node>

    <!-- Spawn BARLAS robot in Gazebo -->
    <node name="spawn_barlas_robot" pkg="gazebo_ros" type="spawn_model" args="-urdf -param robot_description -model barlas_robot -x 0 -y 0 -z 0.5" respawn="false" output="screen"/>

    <!-- ========== BARLAS Control Systems ========== -->
    <!-- Hibrit controller (simulation mode) -->
    <node name="barlas_hibrid_controller" pkg="barlas" type="barlas_hibrid_controller.py" output="screen">
        <param name="simulation_mode" value="true"/>
        <param name="control_frequency" value="10.0"/>
        <param name="emergency_stop_timeout" value="5.0"/>
        <param name="max_linear_velocity" value="2.0"/>
        <param name="max_angular_velocity" value="1.5"/>
    </node>

    <!-- ROS Bridge (simulation mode) -->
    <node name="barlas_ros_bridge" pkg="barlas" type="barlas_ros_bridge.py" output="screen">
        <param name="simulation_mode" value="true"/>
        <param name="mavros_namespace" value="/mavros"/>
        <param name="dart_laser_enabled" value="true"/>
        <param name="obstacle_avoidance_enabled" value="true"/>
    </node>

    <!-- Mission Controller -->
    <node name="mission_controller" pkg="barlas" type="mission_controller.py" output="screen">
        <param name="simulation_mode" value="true"/>
        <param name="mission_file" value="$(find barlas)/config/teknofest_mission.yaml"/>
    </node>

    <!-- ========== Simulated Sensors ========== -->
    <!-- LiDAR simulation -->
    <node name="lidar_node" pkg="barlas" type="lidar_node.py" output="screen">
        <param name="simulation_mode" value="true"/>
        <param name="scan_topic" value="/barlas/sensors/scan"/>
        <param name="frame_id" value="laser_frame"/>
    </node>

    <!-- Obstacle avoidance -->
    <node name="obstacle_avoidance" pkg="barlas" type="obstacle_avoidance.py" output="screen">
        <param name="simulation_mode" value="true"/>
        <param name="safety_distance" value="1.5"/>
        <param name="max_linear_speed" value="1.0"/>
        <param name="max_angular_speed" value="1.5"/>
    </node>

    <!-- ========== Dart Laser System (Simulated) ========== -->
    <include file="$(find barlas_dart_laser)/launch/dart_laser_system.launch">
        <arg name="simulation_mode" value="true"/>
        <arg name="pan_tilt_enabled" value="true"/>
        <arg name="laser_enabled" value="true"/>
        <arg name="dart_enabled" value="false"/>
        <!-- Sim'de dart devre dışı -->
    </include>

    <!-- ========== Competition Environment ========== -->
    <!-- Teknofest parkur engelleri -->
    <node name="spawn_competition_obstacles" pkg="barlas" type="spawn_obstacles.py" output="screen">
        <param name="obstacle_config" value="$(find barlas)/config/teknofest_obstacles.yaml"/>
    </node>

    <!-- Traffic signs for tabela detection -->
    <node name="spawn_traffic_signs" pkg="barlas" type="spawn_signs.py" output="screen">
        <param name="sign_config" value="$(find barlas)/config/traffic_signs.yaml"/>
    </node>

    <!-- Dart targets -->
    <node name="spawn_dart_targets" pkg="barlas" type="spawn_targets.py" output="screen">
        <param name="target_config" value="$(find barlas)/config/dart_targets.yaml"/>
    </node>

    <!-- ========== Visualization and Monitoring ========== -->
    <!-- RViz visualization -->
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find barlas)/rviz/simulation.rviz"/>

    <!-- Competition monitor -->
    <node name="competition_monitor" pkg="barlas" type="competition_monitor.py" output="screen">
        <param name="simulation_mode" value="true"/>
        <param name="scoring_enabled" value="true"/>
    </node>

    <!-- ========== Data Logging ========== -->
    <node name="rosbag_record" pkg="rosbag" type="record" args="/barlas/sensors/scan /barlas/sensors/imu /barlas/sensors/gps
                /barlas/camera/image_raw /barlas/control/cmd_vel
                /barlas/mission/status /barlas/dart/target_detected
                /barlas/competition/score
                -o $(find barlas)/logs/simulation_$(env USER)"/>

</launch>
